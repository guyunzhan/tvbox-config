  "rules": [
    {
      "name": "暴風",
      "hosts": ["bfzy", "bfbfvip", "bfengbf"],
      "regex": ["#EXTINF.*?\\s+.*?adjump.*?\\.ts"]
    },
    {
      "name": "量子",
      "hosts": ["vip.lz", "hd.lz", ".cdnlz"],
      "regex": [
        "#EXT-X-DISCONTINUITY\\r*\\n*#EXTINF:7\\.166667,[\\s\\S]*?#EXT-X-DISCONTINUITY",
        "#EXTINF.*?\\s+.*?08646.*?\\.ts",
        "#EXT-X-DISCONTINUITY\\r*\\n*#EXTINF.*?6\\.667,[\\s\\S]*?#EXT-X-DISCONTINUITY",
        "#EXTINF.*?\\s+.*?48234.*?\\.ts"
      ]
    },
    {
      "name": "非凡",
      "hosts": ["vip.ffzy", "hd.ffzy", "super.ffzy", "cachem3u8.2s0"],
      "regex": [
        "#EXT-X-DISCONTINUITY\\r*\\n*#EXTINF:6\\.400000,[\\s\\S]*?#EXT-X-DISCONTINUITY",
        "#EXT-X-DISCONTINUITY\\r*\\n*#EXTINF:6\\.6666667,[\\s\\S]*?#EXT-X-DISCONTINUITY",
        "#EXTINF.*?\\s+.*?1171.*?\\.ts",
        "#EXTINF.*?\\s+.*?6d7b.*?\\.ts"
      ]
    },
    {
      "name": "索尼",
      "hosts": ["suonizy"],
      "regex": [
        "#EXT-X-DISCONTINUITY\\r*\\n*#EXTINF:1\\.000000,[\\s\\S]*?#EXT-X-DISCONTINUITY",
        "#EXTINF.*?\\s+.*?p1ayer.*?\\.ts"
      ]
    },
    {
      "name": "通用-廣告分段過濾",
      "hosts": ["*"],
      "regex": [
        "#EXTINF:\\s*([0-4]\\.\\d+|5\\.0),.*?(ad|promo|preroll|midroll|postroll)",
        "#EXT-X-DISCONTINUITY[^#]*#EXTINF[^#]*adjump",
        ".*popads\\.net.*",
        ".*doubleclick\\.net.*"
      ]
    }
  ],
